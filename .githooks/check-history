#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
temporary_file=$(mktemp "${TMPDIR:-/tmp}/commit-history.XXXXXX")
trap 'rm -f "$temporary_file"' EXIT HUP INT TERM

if [ "$#" -ne 0 ]; then
  printf '%s\n' 'History check scans all reachable commits and accepts no revisions.' >&2
  exit 2
fi

commits=$(git rev-list --all)

for commit in $commits; do
  git show --no-patch --format=%B "$commit" > "$temporary_file"
  if ! sh "$script_dir/commit-msg" "$temporary_file" >/dev/null; then
    printf 'History check failed at %s.\n' "$commit" >&2
    exit 1
  fi

  author_name=$(git show --no-patch --format=%an "$commit")
  author_email=$(git show --no-patch --format=%ae "$commit")
  committer_name=$(git show --no-patch --format=%cn "$commit")
  committer_email=$(git show --no-patch --format=%ce "$commit")

  if [ "$author_name" != 'KeelMatrix' ] || [ "$author_email" != 'keelmatrix@gmail.com' ] ||
     [ "$committer_name" != 'KeelMatrix' ] || [ "$committer_email" != 'keelmatrix@gmail.com' ]; then
    printf 'History check failed at %s: unexpected author or committer identity.\n' "$commit" >&2
    exit 1
  fi
done
