<Project>
  <ItemGroup Condition="'$(IsPackable)'=='true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Link="README.md" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Link="LICENSE" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Link="icon.png" Condition="Exists('$(MSBuildThisFileDirectory)icon.png') and '$(PackageIcon)'!=''" />
  </ItemGroup>

  <Target Name="ExcludeSensitiveFilesFromPack" BeforeTargets="_GetPackageFiles" Condition="'$(IsPackable)'=='true'">
    <ItemGroup>
      <None Remove="**/.env*;**/keelmatrix.telemetry.json;**/local.settings.json;**/appsettings.Development.json;**/appsettings.Local.json;**/*.secrets.json;**/*.secret.json;**/*.pfx;**/*.p12;**/*.pem;**/*.key;**/*.crt;**/*.cer" />
      <Content Remove="**/.env*;**/keelmatrix.telemetry.json;**/local.settings.json;**/appsettings.Development.json;**/appsettings.Local.json;**/*.secrets.json;**/*.secret.json;**/*.pfx;**/*.p12;**/*.pem;**/*.key;**/*.crt;**/*.cer" />
    </ItemGroup>
  </Target>

  <Target Name="RejectSensitiveFilesInPack" AfterTargets="_GetPackageFiles" Condition="'$(IsPackable)'=='true'">
    <ItemGroup>
      <_SensitivePackageFile Include="@(_PackageFiles)" Condition="$([System.String]::Copy('%(_PackageFiles.Filename)').ToLowerInvariant().StartsWith('.env')) Or $([System.String]::Copy('%(_PackageFiles.Identity)').ToLowerInvariant().Contains('keelmatrix.telemetry.json')) Or $([System.String]::Copy('%(_PackageFiles.Identity)').ToLowerInvariant().EndsWith('local.settings.json')) Or $([System.String]::Copy('%(_PackageFiles.Identity)').ToLowerInvariant().EndsWith('appsettings.development.json')) Or $([System.String]::Copy('%(_PackageFiles.Identity)').ToLowerInvariant().EndsWith('appsettings.local.json')) Or $([System.String]::Copy('%(_PackageFiles.Filename)').ToLowerInvariant().EndsWith('.secrets')) Or $([System.String]::Copy('%(_PackageFiles.Filename)').ToLowerInvariant().EndsWith('.secret')) Or $([System.String]::Copy('%(_PackageFiles.Extension)').ToLowerInvariant().EndsWith('.pfx')) Or $([System.String]::Copy('%(_PackageFiles.Extension)').ToLowerInvariant().EndsWith('.p12')) Or $([System.String]::Copy('%(_PackageFiles.Extension)').ToLowerInvariant().EndsWith('.pem')) Or $([System.String]::Copy('%(_PackageFiles.Extension)').ToLowerInvariant().EndsWith('.key')) Or $([System.String]::Copy('%(_PackageFiles.Extension)').ToLowerInvariant().EndsWith('.crt')) Or $([System.String]::Copy('%(_PackageFiles.Extension)').ToLowerInvariant().EndsWith('.cer'))" />
    </ItemGroup>
    <Error Condition="'@(_SensitivePackageFile)'!=''" Text="Refusing to pack sensitive file(s): @(_SensitivePackageFile, ', ')." />
  </Target>

  <PropertyGroup Condition="'$(IsTestProject)'=='true'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
